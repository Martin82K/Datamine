{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "datamine.landxml-tin.v1",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schema_version",
    "landxml_namespace",
    "source_document_id",
    "source_document_sha256",
    "surface"
  ],
  "properties": {
    "schema_version": {
      "const": "datamine.landxml-tin.v1",
      "type": "string"
    },
    "landxml_namespace": {
      "const": "http://www.landxml.org/schema/LandXML-1.2",
      "type": "string"
    },
    "source_document_id": {
      "minLength": 10,
      "maxLength": 72,
      "pattern": "^document_[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "source_document_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "surface": {
      "$id": "datamine.tin-surface-object.v1",
      "additionalProperties": false,
      "type": "object",
      "required": [
        "schema_version",
        "id",
        "type",
        "layer_id",
        "geometry",
        "properties",
        "provenance"
      ],
      "properties": {
        "schema_version": {
          "const": "datamine.tin-surface-object.v1",
          "type": "string"
        },
        "id": {
          "minLength": 8,
          "maxLength": 72,
          "pattern": "^object_[A-Za-z0-9_-]+$",
          "type": "string"
        },
        "type": {
          "const": "civil.tin_surface",
          "type": "string"
        },
        "layer_id": {
          "minLength": 7,
          "maxLength": 72,
          "pattern": "^layer_[A-Za-z0-9_-]+$",
          "type": "string"
        },
        "geometry": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "kind",
            "coordinate_space",
            "vertices",
            "faces",
            "bounds"
          ],
          "properties": {
            "kind": {
              "const": "indexed_tin",
              "type": "string"
            },
            "coordinate_space": {
              "const": "survey_crs",
              "type": "string"
            },
            "vertices": {
              "minItems": 3,
              "maxItems": 20000,
              "type": "array",
              "items": {
                "type": "array",
                "items": [
                  {
                    "minimum": -100000000,
                    "maximum": 100000000,
                    "type": "number"
                  },
                  {
                    "minimum": -100000000,
                    "maximum": 100000000,
                    "type": "number"
                  },
                  {
                    "minimum": -100000,
                    "maximum": 100000,
                    "type": "number"
                  }
                ],
                "additionalItems": false,
                "minItems": 3,
                "maxItems": 3
              }
            },
            "faces": {
              "minItems": 1,
              "maxItems": 40000,
              "type": "array",
              "items": {
                "type": "array",
                "items": [
                  {
                    "minimum": 0,
                    "maximum": 19999,
                    "type": "integer"
                  },
                  {
                    "minimum": 0,
                    "maximum": 19999,
                    "type": "integer"
                  },
                  {
                    "minimum": 0,
                    "maximum": 19999,
                    "type": "integer"
                  }
                ],
                "additionalItems": false,
                "minItems": 3,
                "maxItems": 3
              }
            },
            "bounds": {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "min",
                "max"
              ],
              "properties": {
                "min": {
                  "type": "array",
                  "items": [
                    {
                      "minimum": -100000000,
                      "maximum": 100000000,
                      "type": "number"
                    },
                    {
                      "minimum": -100000000,
                      "maximum": 100000000,
                      "type": "number"
                    },
                    {
                      "minimum": -100000,
                      "maximum": 100000,
                      "type": "number"
                    }
                  ],
                  "additionalItems": false,
                  "minItems": 3,
                  "maxItems": 3
                },
                "max": {
                  "type": "array",
                  "items": [
                    {
                      "minimum": -100000000,
                      "maximum": 100000000,
                      "type": "number"
                    },
                    {
                      "minimum": -100000000,
                      "maximum": 100000000,
                      "type": "number"
                    },
                    {
                      "minimum": -100000,
                      "maximum": 100000,
                      "type": "number"
                    }
                  ],
                  "additionalItems": false,
                  "minItems": 3,
                  "maxItems": 3
                }
              }
            }
          }
        },
        "properties": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "schema_version",
            "name",
            "crs",
            "review_state"
          ],
          "properties": {
            "schema_version": {
              "const": "datamine.tin-surface-properties.v1",
              "type": "string"
            },
            "name": {
              "minLength": 1,
              "maxLength": 200,
              "type": "string"
            },
            "crs": {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "kind",
                "epsg",
                "axis_order",
                "horizontal_unit",
                "vertical_unit",
                "vertical_datum"
              ],
              "properties": {
                "kind": {
                  "const": "epsg",
                  "type": "string"
                },
                "epsg": {
                  "minimum": 1,
                  "maximum": 999999,
                  "type": "integer"
                },
                "axis_order": {
                  "const": "east_north_up",
                  "type": "string"
                },
                "horizontal_unit": {
                  "const": "m",
                  "type": "string"
                },
                "vertical_unit": {
                  "const": "m",
                  "type": "string"
                },
                "vertical_datum": {
                  "minLength": 1,
                  "maxLength": 100,
                  "type": "string"
                }
              }
            },
            "review_state": {
              "anyOf": [
                {
                  "const": "unreviewed",
                  "type": "string"
                },
                {
                  "const": "confirmed",
                  "type": "string"
                },
                {
                  "const": "corrected",
                  "type": "string"
                },
                {
                  "const": "rejected",
                  "type": "string"
                }
              ]
            }
          }
        },
        "provenance": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "source_document_id",
            "source_document_sha256",
            "source_kind",
            "algorithm_version"
          ],
          "properties": {
            "source_document_id": {
              "minLength": 10,
              "maxLength": 72,
              "pattern": "^document_[A-Za-z0-9_-]+$",
              "type": "string"
            },
            "source_document_sha256": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            "source_job_id": {
              "minLength": 5,
              "maxLength": 72,
              "pattern": "^job_[A-Za-z0-9_-]+$",
              "type": "string"
            },
            "source_kind": {
              "anyOf": [
                {
                  "const": "automatic",
                  "type": "string"
                },
                {
                  "const": "manual",
                  "type": "string"
                },
                {
                  "const": "imported",
                  "type": "string"
                }
              ]
            },
            "algorithm_version": {
              "minLength": 1,
              "maxLength": 100,
              "type": "string"
            },
            "confidence": {
              "minimum": 0,
              "maximum": 1,
              "type": "number"
            },
            "last_command_id": {
              "minLength": 9,
              "maxLength": 72,
              "pattern": "^command_[A-Za-z0-9_-]+$",
              "type": "string"
            }
          }
        }
      }
    }
  }
}
