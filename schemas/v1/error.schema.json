{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "datamine.error.v1",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schema_version",
    "code",
    "message",
    "correlation_id",
    "retryable"
  ],
  "properties": {
    "schema_version": {
      "const": "datamine.error.v1",
      "type": "string"
    },
    "code": {
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Z][A-Z0-9_]+$",
      "type": "string"
    },
    "message": {
      "minLength": 1,
      "maxLength": 500,
      "type": "string"
    },
    "correlation_id": {
      "minLength": 1,
      "maxLength": 100,
      "type": "string"
    },
    "retryable": {
      "type": "boolean"
    }
  }
}
