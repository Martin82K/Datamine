{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "datamine.rooms-export.v1",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schema_version",
    "exporter_version",
    "project_id",
    "document_id",
    "model_version_id",
    "model_revision",
    "model_content_sha256",
    "coordinate_space",
    "units",
    "rooms",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "const": "datamine.rooms-export.v1",
      "type": "string"
    },
    "exporter_version": {
      "minLength": 1,
      "maxLength": 100,
      "type": "string"
    },
    "project_id": {
      "minLength": 9,
      "maxLength": 72,
      "pattern": "^project_[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "document_id": {
      "minLength": 10,
      "maxLength": 72,
      "pattern": "^document_[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "model_version_id": {
      "minLength": 9,
      "maxLength": 72,
      "pattern": "^version_[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "model_revision": {
      "minimum": 0,
      "maximum": 2147483647,
      "type": "integer"
    },
    "model_content_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "coordinate_space": {
      "const": "drawing_m",
      "type": "string"
    },
    "units": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "length",
        "area",
        "volume",
        "elevation"
      ],
      "properties": {
        "length": {
          "const": "m",
          "type": "string"
        },
        "area": {
          "const": "m2",
          "type": "string"
        },
        "volume": {
          "const": "m3",
          "type": "string"
        },
        "elevation": {
          "const": "m",
          "type": "string"
        }
      }
    },
    "rooms": {
      "maxItems": 100000,
      "type": "array",
      "items": {
        "$id": "datamine.room-object.v1",
        "additionalProperties": false,
        "type": "object",
        "required": [
          "schema_version",
          "id",
          "type",
          "layer_id",
          "geometry",
          "properties",
          "provenance"
        ],
        "properties": {
          "schema_version": {
            "const": "datamine.room-object.v1",
            "type": "string"
          },
          "id": {
            "minLength": 8,
            "maxLength": 72,
            "pattern": "^object_[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "type": {
            "const": "rooms.room",
            "type": "string"
          },
          "layer_id": {
            "minLength": 7,
            "maxLength": 72,
            "pattern": "^layer_[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "geometry": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "kind",
              "coordinate_space",
              "rings"
            ],
            "properties": {
              "kind": {
                "const": "polygon",
                "type": "string"
              },
              "coordinate_space": {
                "anyOf": [
                  {
                    "const": "drawing_m",
                    "type": "string"
                  },
                  {
                    "const": "world_m",
                    "type": "string"
                  },
                  {
                    "const": "survey_crs",
                    "type": "string"
                  }
                ]
              },
              "rings": {
                "minItems": 1,
                "maxItems": 128,
                "type": "array",
                "items": {
                  "minItems": 3,
                  "maxItems": 100000,
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": [
                      {
                        "minimum": -100000000,
                        "maximum": 100000000,
                        "type": "number"
                      },
                      {
                        "minimum": -100000000,
                        "maximum": 100000000,
                        "type": "number"
                      }
                    ],
                    "additionalItems": false,
                    "minItems": 2,
                    "maxItems": 2
                  }
                }
              }
            }
          },
          "properties": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "schema_version",
              "number",
              "name",
              "floor_area_m2",
              "geometric_area_m2",
              "table_area_m2",
              "perimeter_m",
              "height_m",
              "floor_level_m",
              "included",
              "quality",
              "area_source",
              "shape_source",
              "review_state"
            ],
            "properties": {
              "schema_version": {
                "const": "datamine.room-properties.v1",
                "type": "string"
              },
              "number": {
                "minLength": 1,
                "maxLength": 50,
                "type": "string"
              },
              "name": {
                "anyOf": [
                  {
                    "minLength": 1,
                    "maxLength": 200,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "floor_area_m2": {
                "minimum": 0,
                "maximum": 10000000,
                "type": "number"
              },
              "geometric_area_m2": {
                "minimum": 0,
                "maximum": 10000000,
                "type": "number"
              },
              "table_area_m2": {
                "anyOf": [
                  {
                    "exclusiveMinimum": 0,
                    "maximum": 10000000,
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "perimeter_m": {
                "minimum": 0,
                "maximum": 1000000,
                "type": "number"
              },
              "height_m": {
                "exclusiveMinimum": 0,
                "maximum": 1000,
                "type": "number"
              },
              "floor_level_m": {
                "minimum": -1000,
                "maximum": 10000,
                "type": "number"
              },
              "included": {
                "type": "boolean"
              },
              "quality": {
                "anyOf": [
                  {
                    "const": "ok",
                    "type": "string"
                  },
                  {
                    "const": "mismatch",
                    "type": "string"
                  },
                  {
                    "const": "leak",
                    "type": "string"
                  },
                  {
                    "const": "no_seed",
                    "type": "string"
                  },
                  {
                    "const": "unverified",
                    "type": "string"
                  }
                ]
              },
              "area_source": {
                "anyOf": [
                  {
                    "const": "geometry",
                    "type": "string"
                  },
                  {
                    "const": "ocr_table",
                    "type": "string"
                  },
                  {
                    "const": "estimate",
                    "type": "string"
                  },
                  {
                    "const": "manual",
                    "type": "string"
                  }
                ]
              },
              "shape_source": {
                "anyOf": [
                  {
                    "const": "measured",
                    "type": "string"
                  },
                  {
                    "const": "estimate",
                    "type": "string"
                  },
                  {
                    "const": "manual",
                    "type": "string"
                  }
                ]
              },
              "review_state": {
                "anyOf": [
                  {
                    "const": "unreviewed",
                    "type": "string"
                  },
                  {
                    "const": "confirmed",
                    "type": "string"
                  },
                  {
                    "const": "corrected",
                    "type": "string"
                  },
                  {
                    "const": "rejected",
                    "type": "string"
                  }
                ]
              }
            }
          },
          "provenance": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "source_document_id",
              "source_document_sha256",
              "source_kind",
              "algorithm_version"
            ],
            "properties": {
              "source_document_id": {
                "minLength": 10,
                "maxLength": 72,
                "pattern": "^document_[A-Za-z0-9_-]+$",
                "type": "string"
              },
              "source_document_sha256": {
                "pattern": "^[a-f0-9]{64}$",
                "type": "string"
              },
              "source_job_id": {
                "minLength": 5,
                "maxLength": 72,
                "pattern": "^job_[A-Za-z0-9_-]+$",
                "type": "string"
              },
              "source_kind": {
                "anyOf": [
                  {
                    "const": "automatic",
                    "type": "string"
                  },
                  {
                    "const": "manual",
                    "type": "string"
                  },
                  {
                    "const": "imported",
                    "type": "string"
                  }
                ]
              },
              "algorithm_version": {
                "minLength": 1,
                "maxLength": 100,
                "type": "string"
              },
              "confidence": {
                "minimum": 0,
                "maximum": 1,
                "type": "number"
              },
              "last_command_id": {
                "minLength": 9,
                "maxLength": 72,
                "pattern": "^command_[A-Za-z0-9_-]+$",
                "type": "string"
              }
            }
          }
        }
      }
    },
    "summary": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "rooms_total",
        "rooms_included",
        "floor_area_m2",
        "geometric_area_m2",
        "volume_m3"
      ],
      "properties": {
        "rooms_total": {
          "minimum": 0,
          "maximum": 100000,
          "type": "integer"
        },
        "rooms_included": {
          "minimum": 0,
          "maximum": 100000,
          "type": "integer"
        },
        "floor_area_m2": {
          "minimum": 0,
          "maximum": 10000000000,
          "type": "number"
        },
        "geometric_area_m2": {
          "minimum": 0,
          "maximum": 10000000000,
          "type": "number"
        },
        "volume_m3": {
          "minimum": 0,
          "maximum": 10000000000000,
          "type": "number"
        }
      }
    }
  }
}
