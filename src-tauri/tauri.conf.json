{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Datamine",
  "version": "0.1.0",
  "identifier": "cz.datamine.editor",
  "build": {
    "beforeDevCommand": "npm run v2:dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run v2:build",
    "frontendDist": "../apps/web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Datamine V2",
        "width": 1440,
        "height": 960,
        "minWidth": 900,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' blob: ipc: http://ipc.localhost; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "worker/datamine-stakeout/": "worker/"
    },
    "targets": [
      "nsis",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
